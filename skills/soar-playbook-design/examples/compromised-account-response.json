{
  "schema_version": "1.0",
  "id": "pb-compromised-account-response",
  "name": "Compromised user account: evidence, approval, contain in the right order",
  "version": "1.0.2",
  "owner": "soc-automation@yourcompany.example",
  "description": "On a high-risk sign-in alert, collect the evidence an analyst needs (recent sign-ins, MFA changes, inbox rules, consent grants), open a case, and, after tier-2 approval, revoke sessions, then reset the password, then disable persistence. Order matters: revoke before reset so a valid refresh token does not survive. Break-glass and service accounts are excluded at the trigger and rechecked before containment.",
  "tags": ["identity", "containment", "tier2"],
  "trigger": {
    "type": "alert",
    "source": "idp:risk-detection",
    "filter": "risk_level == 'high' and user.type == 'member' and user not in config.break_glass_accounts and user not in config.service_accounts",
    "dedupe_key": "user_principal_name",
    "rate_limit": {"max_runs": 30, "window_minutes": 60},
    "kill_switch": "soar:disable pb-compromised-account-response; IAM on-call can pause via config.containment_enabled=false"
  },
  "inputs": [
    {"name": "user_principal_name", "type": "string", "required": true},
    {"name": "alert_id", "type": "string", "required": true},
    {"name": "risk_detail", "type": "object", "required": false}
  ],
  "start": "recheck_exclusions",
  "steps": [
    {"id": "recheck_exclusions", "name": "Re-verify user is not break-glass, service, or executive-protected", "type": "transform",
     "action": "iam.classify_user", "integration": "idp",
     "inputs": {"upn": "{{inputs.user_principal_name}}"},
     "timeout_seconds": 20, "on_failure": "abort", "next": "excluded?"},
    {"id": "excluded?", "name": "Route excluded accounts to humans only", "type": "decision",
     "branches": [{"when": "recheck_exclusions.class in ('break_glass', 'service', 'executive')", "next": "open_case_manual"}],
     "default": "signins", "on_failure": "open_case_manual"},
    {"id": "signins", "name": "Pull 7 days of sign-ins with IP, ASN, country, device, MFA result", "type": "enrichment",
     "action": "idp.get_signins", "integration": "idp",
     "inputs": {"upn": "{{inputs.user_principal_name}}", "days": 7},
     "timeout_seconds": 120, "retries": 1, "on_failure": "open_case_manual", "next": "persistence"},
    {"id": "persistence", "name": "Inbox rules, forwarding, MFA method changes, OAuth consents", "type": "enrichment",
     "action": "m365.get_persistence_artifacts", "integration": "mail-and-collab",
     "inputs": {"upn": "{{inputs.user_principal_name}}", "days": 14},
     "timeout_seconds": 120, "retries": 1, "on_failure": "open_case_manual", "next": "score"},
    {"id": "score", "name": "Summarise indicators for the approver", "type": "transform",
     "action": "identity.summarise", "integration": "internal-scoring",
     "inputs": {"signins": "{{signins.rows}}", "persistence": "{{persistence.items}}", "risk": "{{inputs.risk_detail}}"},
     "timeout_seconds": 10, "on_failure": "open_case_manual", "next": "open_case"},
    {"id": "open_case", "name": "Open P2 case with evidence", "type": "ticketing",
     "action": "case.create", "integration": "case-management",
     "inputs": {"title": "Possible account compromise: {{inputs.user_principal_name}}", "severity": "P2", "summary": "{{score.summary}}", "evidence": {"signins": "{{signins.rows}}", "persistence": "{{persistence.items}}"}},
     "timeout_seconds": 60, "retries": 2, "idempotency_key": "case:{{inputs.alert_id}}", "on_failure": "escalate", "next": "approve"},
    {"id": "open_case_manual", "name": "Open case for manual handling (no automation)", "type": "ticketing",
     "action": "case.create", "integration": "case-management",
     "inputs": {"title": "Risky sign-in (manual): {{inputs.user_principal_name}}", "severity": "P2", "note": "Excluded account class or enrichment failure; no automated containment."},
     "timeout_seconds": 60, "retries": 2, "idempotency_key": "case:{{inputs.alert_id}}", "on_failure": "escalate", "next": "done"},
    {"id": "approve", "name": "Tier 2 approves containment sequence", "type": "approval",
     "approvers": ["soc-tier2-oncall", "iam-oncall"], "timeout_minutes": 45, "on_timeout": "notify_no_action", "on_reject": "notify_no_action",
     "prompt": "Contain {{inputs.user_principal_name}}? Indicators: {{score.summary}}. Sequence: revoke sessions -> reset password -> remove inbox rules and forwarding -> revoke suspicious consents. Case {{open_case.case_id}}.",
     "on_failure": "escalate", "next": "revoke"},
    {"id": "revoke", "name": "Revoke all refresh and session tokens", "type": "containment",
     "action": "idp.revoke_sessions", "integration": "idp",
     "inputs": {"upn": "{{inputs.user_principal_name}}"},
     "timeout_seconds": 60, "idempotency_key": "revoke:{{inputs.alert_id}}", "dry_run_supported": true,
     "rollback": {"action": "none", "notes": "Not reversible; user re-authenticates. Low harm."},
     "on_failure": "escalate", "next": "reset"},
    {"id": "reset", "name": "Force password reset with temporary credential delivered out-of-band", "type": "containment",
     "action": "idp.force_password_reset", "integration": "idp",
     "inputs": {"upn": "{{inputs.user_principal_name}}", "delivery": "helpdesk-phone-verification"},
     "approval": {"required": true, "approvers": ["iam-oncall"], "timeout_minutes": 30, "on_timeout": "notify_partial", "on_reject": "notify_partial"},
     "timeout_seconds": 60, "idempotency_key": "reset:{{inputs.alert_id}}", "dry_run_supported": true,
     "rollback": {"action": "none", "notes": "Not reversible; helpdesk assists user. Do not reset service or break-glass accounts (excluded at trigger and recheck)."},
     "on_failure": "notify_partial", "next": "remove_persistence"},
    {"id": "remove_persistence", "name": "Disable inbox rules and forwarding, revoke flagged consents", "type": "remediation",
     "action": "m365.remove_persistence", "integration": "mail-and-collab",
     "inputs": {"upn": "{{inputs.user_principal_name}}", "items": "{{persistence.flagged}}", "mode": "disable"},
     "approval": {"required": true, "approvers": ["soc-tier2-oncall"], "timeout_minutes": 30, "on_timeout": "notify_partial", "on_reject": "notify_partial"},
     "timeout_seconds": 120, "idempotency_key": "persist:{{inputs.alert_id}}", "dry_run_supported": true,
     "rollback": {"action": "m365.restore_persistence", "inputs": {"upn": "{{inputs.user_principal_name}}", "items": "{{persistence.flagged}}"}, "notes": "Rules are disabled not deleted so they can be re-enabled if benign."},
     "on_failure": "notify_partial", "next": "notify_done"},
    {"id": "notify_done", "name": "Update case and notify user via helpdesk", "type": "notification",
     "action": "case.add_note", "integration": "case-management",
     "inputs": {"case_id": "{{open_case.case_id}}", "note": "Containment complete: sessions revoked, password reset, persistence disabled. Helpdesk to contact user by phone."},
     "timeout_seconds": 60, "on_failure": "continue", "next": "done"},
    {"id": "notify_partial", "name": "Record partial containment and page tier 2", "type": "notification",
     "action": "case.add_note_and_page", "integration": "case-management",
     "inputs": {"case_id": "{{open_case.case_id}}", "note": "Containment incomplete; see run log for the step that stopped.", "page": "soc-tier2-oncall"},
     "timeout_seconds": 60, "on_failure": "escalate", "next": "done"},
    {"id": "notify_no_action", "name": "Record that containment was not approved", "type": "notification",
     "action": "case.add_note", "integration": "case-management",
     "inputs": {"case_id": "{{open_case.case_id}}", "note": "Automated containment not approved or timed out; analyst to handle manually."},
     "timeout_seconds": 60, "on_failure": "continue", "next": "done"},
    {"id": "done", "name": "End", "type": "end"}
  ],
  "metrics": ["time_alert_to_case", "time_case_to_approval", "approval_rate", "containment_completed_ratio", "partial_containment_count", "user_complaints_after_reset"],
  "testing": {
    "dry_run_supported": true,
    "test_cases": [
      {"name": "member account with inbox rule", "input": {"user_principal_name": "j.doe@yourcompany.example", "alert_id": "T-10"}, "expect_path": ["recheck_exclusions", "excluded?", "signins", "persistence", "score", "open_case", "approve"]},
      {"name": "break-glass account never automated", "input": {"user_principal_name": "breakglass1@yourcompany.example", "alert_id": "T-11"}, "expect_path": ["recheck_exclusions", "excluded?", "open_case_manual", "done"]},
      {"name": "approval timeout leaves account untouched", "fault": "approve:timeout", "expect_path": ["approve", "notify_no_action", "done"]}
    ]
  }
}
